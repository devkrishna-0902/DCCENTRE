{
  "entities": {
    "Enrollment": {
      "title": "Enrollment",
      "description": "A student enrollment record.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The student's full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The student's email address."
        },
        "course": {
          "type": "string",
          "description": "The course the student is enrolling in."
        },
        "phone": {
          "type": "string",
          "description": "The student's phone number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the enrollment was created."
        }
      },
      "required": ["fullName", "email", "course", "phone", "createdAt"]
    }
  },
  "firestore": {
    "/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Collection of student enrollments."
    }
  }
}
